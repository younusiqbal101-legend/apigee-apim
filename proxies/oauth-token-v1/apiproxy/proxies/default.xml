<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step><Name>SA-TokenSpikeArrest</Name></Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="token">
      <Request>
        <Step><Name>OA-GenerateAccessToken</Name></Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/token") and (request.verb = "POST")</Condition>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow"><Request/><Response/></PostFlow>
  <HTTPProxyConnection>
    <BasePath>/oauth/v1</BasePath>
  </HTTPProxyConnection>
  <!-- no target: the gateway answers token requests itself -->
  <RouteRule name="noroute"/>
</ProxyEndpoint>
